rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isPrimaryAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'harshkumarrr143@gmail.com';
    }

    // 1. Articles collection
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. Settings & Allowed Emails
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /allowed_emails/{emailId} {
      allow read, write: if true;
    }

    // 3. Hidden Slugs collection
    match /hidden_slugs/{slugId} {
      allow read, write: if true;
    }

    // 4. Team Members collection
    match /team_members/{memberId} {
      allow read, write: if true;
    }

    // 5. Work Projects collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // 6. Contact Inquiries collection
    match /contact_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Default fallback: allow read/write for all application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
